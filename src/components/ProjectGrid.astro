---
import type { ProjectEntry } from '../data/resume';
import { siGithub } from 'simple-icons';
import TechBadge from './TechBadge.astro';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 ? (
    <div class="project-showcase">
      {projects.map((project, index) => {
        const detailsId = `project-details-${index}-${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

        return (
          <article class:list={['project-case', { 'project-case-featured': project.featured }]}>
            <div class="project-main">
              <div class="project-kicker">
                <p class="item-subtitle">{project.role}</p>
                {project.featured && <span class="project-feature-label">Featured build</span>}
              </div>
              <h3>{project.name}</h3>
              <p class="project-summary">{project.summary}</p>
            </div>
            <details class="project-details">
              <summary class="project-details-button" aria-controls={detailsId}>
                <span>Additional details</span>
                <span class="details-icon" aria-hidden="true" />
              </summary>
              <div
                id={detailsId}
                class="project-proof-grid project-expanded"
                aria-label={`${project.name} additional engineering details`}
              >
                {project.proof.map((item) => (
                  <div class="project-proof-item">
                    <span>{item.label}</span>
                    <p>{item.text}</p>
                  </div>
                ))}
              </div>
            </details>
            <aside class="project-side" aria-label={`${project.name} links and stack`}>
              <ul class="tag-list project-stack" aria-label={`${project.name} technologies`}>
                {project.technologies.map((technology) => (
                  <TechBadge name={technology} />
                ))}
              </ul>
              {project.href && (
                <div class="project-footer">
                  <div class="project-links">
                    <a class="text-link icon-link" href={project.href} target="_blank" rel="noreferrer">
                      <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d={siGithub.path} />
                      </svg>
                      GitHub repo
                    </a>
                    {project.phlosionDemoHref && (
                      <a
                        class="text-link icon-link project-demo-link"
                        href={project.phlosionDemoHref}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`View ${project.name} demo on the Phlosion software product lab`}
                        title={`View ${project.name} demo on the Phlosion software product lab`}
                      >
                        <img
                          class="phlosion-link-mark"
                          src="/images/phlosion-mark.png"
                          alt=""
                          width="1254"
                          height="1254"
                          loading="lazy"
                        />
                        Demo on Phlosion
                      </a>
                    )}
                  </div>
                </div>
              )}
            </aside>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="empty-state">Project details are being finalized.</p>
  )
}

<script>
  const setupProjectDetailsAnimation = () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const detailsElements = document.querySelectorAll('.project-details');

    const visibleHeaderOffset = () => {
      const header = document.querySelector('.site-header');

      if (!(header instanceof HTMLElement)) {
        return 0;
      }

      const position = window.getComputedStyle(header).position;
      return position === 'sticky' || position === 'fixed' ? header.getBoundingClientRect().height : 0;
    };

    const scrollExpandedContentIntoView = (expanded: Element | null) => {
      if (!(expanded instanceof HTMLElement)) {
        return;
      }

      const rect = expanded.getBoundingClientRect();
      const targetTop = Math.max(0, window.scrollY + rect.top - visibleHeaderOffset() - 18);
      window.scrollTo({
        top: targetTop,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    detailsElements.forEach((details) => {
      if (!(details instanceof HTMLDetailsElement) || details.dataset.animationReady === 'true') {
        return;
      }

      const summary = details.querySelector('summary');
      const expanded = details.querySelector('.project-expanded');

      if (!(summary instanceof HTMLElement) || !(expanded instanceof HTMLElement)) {
        return;
      }

      details.dataset.animationReady = 'true';
      details.classList.add('project-details-enhanced');

      const resetExpandedStyles = () => {
        expanded.style.height = '';
        expanded.style.opacity = '';
        expanded.style.overflow = '';
        delete details.dataset.animating;
      };

      const openDetails = () => {
        details.open = true;

        if (reduceMotion.matches) {
          resetExpandedStyles();
          scrollExpandedContentIntoView(expanded);
          return;
        }

        details.dataset.animating = 'open';
        expanded.style.height = '0px';
        expanded.style.opacity = '0';
        expanded.style.overflow = 'hidden';

        requestAnimationFrame(() => {
          expanded.style.height = `${expanded.scrollHeight}px`;
          expanded.style.opacity = '1';
          scrollExpandedContentIntoView(expanded);
        });

        const handleOpenEnd = (event: TransitionEvent) => {
          if (event.propertyName === 'height' && details.dataset.animating === 'open') {
            expanded.removeEventListener('transitionend', handleOpenEnd);
            resetExpandedStyles();
          }
        };

        expanded.addEventListener('transitionend', handleOpenEnd);
      };

      const closeDetails = () => {
        if (reduceMotion.matches) {
          details.open = false;
          resetExpandedStyles();
          return;
        }

        details.dataset.animating = 'close';
        expanded.style.height = `${expanded.scrollHeight}px`;
        expanded.style.opacity = '1';
        expanded.style.overflow = 'hidden';

        requestAnimationFrame(() => {
          expanded.style.height = '0px';
          expanded.style.opacity = '0';
        });

        const handleCloseEnd = (event: TransitionEvent) => {
          if (event.propertyName === 'height' && details.dataset.animating === 'close') {
            expanded.removeEventListener('transitionend', handleCloseEnd);
            details.open = false;
            resetExpandedStyles();
          }
        };

        expanded.addEventListener('transitionend', handleCloseEnd);
      };

      summary.addEventListener('click', (event) => {
        event.preventDefault();

        if (details.dataset.animating) {
          return;
        }

        if (details.open) {
          closeDetails();
        } else {
          openDetails();
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectDetailsAnimation, { once: true });
  } else {
    setupProjectDetailsAnimation();
  }
</script>
