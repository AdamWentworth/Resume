---
import type { ProjectEntry } from '../data/resume';
import { siGithub } from 'simple-icons';
import TechBadge from './TechBadge.astro';

interface Props {
  projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 ? (
    <div class="project-showcase">
      {projects.map((project, index) => {
        const detailsId = `project-details-${index}-${project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

        return (
          <article class:list={['project-case', { 'project-case-featured': project.featured }]}>
            <div class="project-main">
              <div class="project-kicker">
                <p class="item-subtitle">{project.role}</p>
                {project.featured && <span class="project-feature-label">Featured build</span>}
              </div>
              <h3>{project.name}</h3>
              <p class="project-summary">{project.summary}</p>
            </div>
            <details class="project-details">
              <summary class="project-details-button" aria-controls={detailsId}>
                <span>Additional details</span>
                <span class="details-icon" aria-hidden="true" />
              </summary>
              <div
                id={detailsId}
                class="project-proof-grid project-expanded"
                aria-label={`${project.name} additional engineering details`}
              >
                {project.proof.map((item) => (
                  <div class="project-proof-item">
                    <span>{item.label}</span>
                    <p>{item.text}</p>
                  </div>
                ))}
              </div>
            </details>
            <aside class="project-side" aria-label={`${project.name} links and stack`}>
              <ul class="tag-list project-stack" aria-label={`${project.name} technologies`}>
                {project.technologies.map((technology) => (
                  <TechBadge name={technology} />
                ))}
              </ul>
              {project.href && (
                <div class="project-footer">
                  <a class="text-link icon-link" href={project.href} target="_blank" rel="noreferrer">
                    <svg class="link-icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={siGithub.path} />
                    </svg>
                    GitHub repo
                  </a>
                </div>
              )}
            </aside>
          </article>
        );
      })}
    </div>
  ) : (
    <p class="empty-state">Project details are being finalized.</p>
  )
}
