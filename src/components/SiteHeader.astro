---
import { resume } from '../data/resume';

const navItems = [
  { href: '#summary', label: 'Summary' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#education', label: 'Education' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${resume.name} home`}>
      <img class="brand-mark-image" src="/assets/aw-mark.png" alt="" width="640" height="640" />
      <img class="brand-wordmark-image" src="/assets/aw-wordmark.png" alt="" width="1270" height="205" />
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="button button-compact" href={resume.resumePdf.href}>{resume.resumePdf.label}</a>
  </div>
</header>
