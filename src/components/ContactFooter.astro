---
import ActionIcon from './ActionIcon.astro';
import { resume } from '../data/resume';
---

<footer id="contact" class="contact-footer" aria-labelledby="contact-title">
  <div class="container contact-inner">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title">Start a conversation</h2>
      <p>
        For 2027 software engineering roles, project conversations, or collaboration, email Adam or use the profile
        links below.
      </p>
    </div>
    <div class="contact-actions">
      <a class="button link-with-icon" href={`mailto:${resume.email}`}>
        <ActionIcon label="Email" />
        Email Adam
      </a>
      {
        resume.links
          .filter((link) => link.external)
          .map((link) => (
            <a class="text-link link-with-icon" href={link.href} target="_blank" rel="noreferrer">
              <ActionIcon label={link.label} />
              {link.label}
            </a>
          ))
      }
    </div>
  </div>
</footer>
