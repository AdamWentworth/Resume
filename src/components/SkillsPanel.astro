---
import type { SkillGroup } from '../data/resume';
import TechBadge from './TechBadge.astro';

interface Props {
  groups: SkillGroup[];
}

const { groups } = Astro.props;
---

<div class="skills-layout">
  <div class="skills-grid">
    {groups.map((group) => (
      <section class="skill-group" aria-labelledby={`skill-${group.name.toLowerCase().replaceAll(' ', '-')}`}>
        <h3 id={`skill-${group.name.toLowerCase().replaceAll(' ', '-')}`}>{group.name}</h3>
        <p>{group.summary}</p>
        <ul class="tag-list skill-tag-list">
          {group.items.map((item) => <TechBadge name={item} />)}
        </ul>
      </section>
    ))}
  </div>
</div>
