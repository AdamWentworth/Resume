---
import ContactFooter from '../components/ContactFooter.astro';
import EducationPanel from '../components/EducationPanel.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkillsPanel from '../components/SkillsPanel.astro';
import { resume } from '../data/resume';
import Layout from '../layouts/Layout.astro';

const title = `${resume.name} | ${resume.role}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.name,
  url: resume.siteUrl,
  email: resume.email,
  jobTitle: resume.role,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CA',
  },
  sameAs: resume.links.filter((link) => link.external).map((link) => link.href),
  knowsAbout: resume.skills.flatMap((group) => group.items),
};
---

<Layout title={title} description={resume.summary} canonical={resume.siteUrl} structuredData={structuredData}>
  <a class="skip-link" href="#summary">Skip to summary</a>
  <SiteHeader />
  <main>
    <Hero />

    <section id="projects" class="section-band section-muted" aria-labelledby="projects-title">
      <div class="container project-section">
        <SectionHeading
          eyebrow="Projects"
          title="Project case studies"
          description="These are the builds I want recruiters to evaluate me by: real systems with service boundaries, runtime constraints, tooling, tests, and follow-through."
          headingId="projects-title"
        />
        <ProjectGrid projects={resume.projects} />
        <aside class="project-lab-callout" aria-label="Additional project catalog">
          <div>
            <p class="item-subtitle">More project work</p>
            <h3>Phlosion carries the broader product lab.</h3>
            <p>
              For additional work including local AI assistant tooling, audio ML workflows, desktop game modding tools,
              League analytics demos, and captured product walkthroughs, see the full Phlosion catalog.
            </p>
          </div>
          <a
            class="button button-compact phlosion-button"
            href="https://phlosion.com/#products"
            target="_blank"
            rel="noreferrer"
          >
            <img class="phlosion-button-mark" src="/images/phlosion-mark.png" alt="" width="1254" height="1254" />
            Explore Phlosion
          </a>
        </aside>
      </div>
    </section>

    <section id="skills" class="section-band" aria-labelledby="skills-title">
      <div class="container section-grid">
        <SectionHeading
          eyebrow="Skills"
          title="Technical skills"
          description="A compact skills matrix for the languages, frameworks, systems, and fundamentals behind the project work."
          headingId="skills-title"
        />
        <SkillsPanel groups={resume.skills} />
      </div>
    </section>

    <section id="education" class="section-band section-compact section-muted" aria-labelledby="education-title">
      <div class="container section-grid">
        <SectionHeading
          eyebrow="Education"
          title="Education and credentials"
          description="Current Applied Computer Science study, earlier computing diploma work, and audio production training."
          headingId="education-title"
        />
        <EducationPanel education={resume.education} />
      </div>
    </section>

    <section id="experience" class="section-band" aria-labelledby="experience-title">
      <div class="container section-grid">
        <SectionHeading
          eyebrow="Experience"
          title="Practical experience around the engineering path"
          description="A compact timeline of technical support, data operations, and client-facing work that complements the project portfolio."
          headingId="experience-title"
        />
        <ExperienceTimeline entries={resume.experience} />
      </div>
    </section>
  </main>
  <ContactFooter />
</Layout>
